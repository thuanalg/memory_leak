[-] vape		<-->	verb++	[241101][001]	./veɪp/-NAmE /veɪp/
[intransitive, transitive]
	;hút thuốc	 -- (1) to take vapour from an e-cigarette or similar device into your mouth and let it out again
		;Are you allowed to vape at work?
		;vape something Many smokers have started vaping e-cigarettes.




[-] nightstand		<-->	n++	[241101][001]	./ˈnaɪtstænd/-NAmE /ˈnaɪtstænd/
(also night table (both North American English), bedside table especially in British English)
	;bàn nhỏ sát giường ngủ -- (1) enlarge image,a small table next to a bed
	;;







[-] clout		<-->	n++	[241101][001]	./klaʊt/-NAmE /klaʊt/
	;sức ảnh hưởng -- (1) [uncountable] power and influence
		;political/financial clout
		;I knew his opinion carried a lot of clout with them.
		;Extra Examples:
		;The companies used their clout to influence policy.
		;This movie is an opportunity to increase his clout in Hollywood.
		;a politician with enormous clout
		;the growing political clout of the army
		;The government cannot ignore the growing political clout of the security forces.
				;Oxford Collocations Dictionary
				;adjective
				;considerableenormouseconomic…
				;verb + clout
				;carryhavewield…
		;See full entry
	; -- (2) [countable, usually singular] (especially British English, informal) a hard hit with the hand or a hard object
		;You’re not too big for a clout round the ear!
		;Word Origin
	;;












[-] clout		<-->	verb++	[241101][001]	./klaʊt/-NAmE /klaʊt/
(especially British English, informal)
	;vỗ -- (1) clout somebody to hit somebody hard, especially with your hand
		;He started to clout me round the head, yelling at the top of his voice.
		;Someone clouted me on the left shoulder.
		;Word Origin
	;;












[-] obfuscate		<-->	verb++[--0]	./ˈɒbfəskeɪt/
 /ˈɑːbfəskeɪt/
[intransitive, transitive] (formal)
	;làm mờ, mờ -- (1) obfuscate (something) to make something less clear and more difficult to understand, usually deliberately
		;synonym obscure
		;Word Origin
	;;




[-] thatch		<-->	noun++C2	[221110][002]	./θætʃ/-NAmE /θætʃ/ [IE-B1-Z10-170] [t]
	;cỏ khô, như rơm rạ, ...  -- (1) enlarge image[uncountable, countable] dried straw, reeds, etc. used for making a roof; a roof made of this material
		;a roof made of thatch
		;The thatch was badly damaged in the storm.
		;Topics Houses and homesc2, Buildingsc2
	;tóc dày -- (2) singular] thatch (of hair) (informal) thick hair on somebody’s head
		;He had a thatch of thick brown hair.
		;Fortunately, I've got a reasonably thick thatch left.
		;Topics Appearancec2
	;;






[-] thatch		<-->	verb++C2	[220819][002]	./θætʃ/-NAmE /θætʃ/ [IE-B1-Z10] [t]
	;lợp cỏ  -- (1) ​thatch something to cover the roof of a building with thatch
		;Topics Buildings-c2
		;Word Origin
	;;






[-] thatched		<-->	adjective++C2	[221110][004]	./θætʃt/-NAmE /θætʃt/ [IE-B1-Z10] [t]
	;lợp tranh, cỏ  -- (1) (of a building) having the roof covered with thatch
		;They live in a thatched cottage.
		;The farmhouse had a thatched roof.
		;Topics Buildingsc2
	;;





